{
  "name": "meu-dinheiro-app",
  "version": "1.0.0-beta.1",
  "private": true,
  "description": "Meu Dinheiro - controle de finanças pessoais",
  "author": "kvojps <62623689+kvojps@users.noreply.github.com>",
  "homepage": "https://github.com/kvojps/meu-dinheiro-app",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "dist:win": "npm run notices && electron-vite build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run notices && electron-vite build && electron-builder --linux deb --x64 --publish never",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "build": {
    "appId": "com.meudinheiro.app",
    "productName": "Meu Dinheiro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "meu-dinheiro-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "maintainer": "kvojps <62623689+kvojps@users.noreply.github.com>",
      "artifactName": "meu-dinheiro-${version}-linux-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^1.44.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.9.2",
    "unzipper": "^0.12.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.11"
  }
}
